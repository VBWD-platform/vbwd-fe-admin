# TLS terminates at the OUTER (host) proxy; this container listens on plain :80,
# so `$scheme` here is always "http". Relay the scheme the edge actually saw so
# the backend can build `https://` redirect Locations (Flask reads it via
# ProxyFix). Without this, any Werkzeug redirect — e.g. the `merge_slashes` 308
# on a doubled-slash path like `/api/v1//ghrm/config` — emits an absolute
# `http://` Location, which the browser blocks as mixed content on an HTTPS page.
# Falls back to `$scheme` when the header is absent (direct container access).
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;

    # This server listens on plain :80 behind a TLS-terminating proxy, so nginx
    # would otherwise glue `http://$host` onto every redirect it generates itself
    # (e.g. the `location = /` → /admin/ 301, try_files directory redirects).
    # Keep those Locations relative — the browser resolves them against the
    # current HTTPS origin.
    absolute_redirect off;
    port_in_redirect off;

    # AI generation routes (cms-ai) call out to slow LLM / image providers and
    # can take minutes; raise the read/send timeout so long generations don't
    # 504. nginx matches the longest prefix, so the general /api/ block keeps its
    # 60s cap. (More specific location must precede /api/.)
    location /api/v1/plugins/cms-ai/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Proxy all /api/ requests to the backend container
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 60s;
    }

    # Admin SPA — Vite is built with base: '/admin/'
    # Assets are referenced as /admin/assets/*, served via alias to dist/

    # Content-hashed build assets: the filename changes on every rebuild, so the
    # bytes behind a given URL are immutable — cache them hard. A MISSING asset
    # must 404 (=404), NOT fall through to index.html: a stale tab that requests
    # an old chunk hash after a redeploy then gets a clean 404 instead of the SPA
    # shell served as text/html (which trips strict-MIME module loading).
    location /admin/assets/ {
        alias /usr/share/nginx/html/assets/;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /admin/ {
        alias /usr/share/nginx/html/;
        index index.html;
        # `/admin/` itself is served here by the `index` directive (the `$uri/`
        # arm), NOT by the `= /admin/index.html` exact match below — that one only
        # fires when a client asks for the full filename. Without this header the
        # entry document shipped with no Cache-Control at all, so browsers
        # heuristically cached it and kept loading the previous build's year-
        # immutable chunks. Hashed assets keep their 1y immutable caching via the
        # more specific `location /admin/assets/` block above.
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ @admin_spa;
    }

    # The SPA entry document must always be revalidated so a redeploy's new asset
    # hashes are picked up immediately. Without this, browsers heuristically cache
    # index.html and keep requesting the previous build's (now-404) chunk hashes.
    location = /admin/index.html {
        alias /usr/share/nginx/html/index.html;
        add_header Cache-Control "no-cache" always;
    }

    location @admin_spa {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache" always;
        rewrite ^ /index.html break;
    }

    # Redirect bare / to /admin/
    location = / {
        return 301 /admin/;
    }
}
